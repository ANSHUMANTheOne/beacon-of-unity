# No credentials belong in Vite variables, Git, or the browser bundle.
# Optional server-side email provider, set with wrangler secret put RESEND_API_KEY:
# RESEND_API_KEY=
# EMAIL_FROM=Social <hello@beaconofunity.com>

# Optional server-only SendPulse credentials (or use the private admin form):
# SENDPULSE_API_KEY=
# EMAIL_SENDER_ADDRESS=hello@beaconofunity.com
# EMAIL_SENDER_NAME=Social
# EMAIL_SETTINGS_KEY=<64 hex chars, install as Worker secret; do not commit>
