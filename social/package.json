{
  "name": "beacon-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "start": "wrangler dev --env local --ip 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply social-db --env local --local",
    "db:remote": "wrangler d1 migrations apply social-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.92.0"
  }
}
